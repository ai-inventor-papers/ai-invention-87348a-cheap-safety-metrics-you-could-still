\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scatter plot of C12 (twin d-prime) versus balanced safety ($S_2$) for the 23 graded checkpoints, coloured by architecture family. C12 is the sole candidate to pass all six selection rules under the amended forms, with Spearman $\rho = 0.61$ $[0.36, 0.87]$. Unlike C2, C12's values are more evenly distributed: 12 of 23 models exceed the random-direction null.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:c12_scatter}{{2}{7}{Scatter plot of C12 (twin d-prime) versus balanced safety ($S_2$) for the 23 graded checkpoints, coloured by architecture family. C12 is the sole candidate to pass all six selection rules under the amended forms, with Spearman $\rho = 0.61$ $[0.36, 0.87]$. Unlike C2, C12's values are more evenly distributed: 12 of 23 models exceed the random-direction null}{figure.2}{}}
\@writefile{toc}{\contentsline {paragraph}{C2 versus the logit gap.}{7}{section*.15}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Selection-rule verdicts on the balanced target ($n = 23$ graded checkpoints, 8 families, 11 lineages). $\rho $: Spearman with $S_2$. Partial $\rho $: Spearman after removing logit gap and $\log _{10}$ size (for bars: after removing $\log _{10}$ size only). Rules S2(b) and S3 use the amended forms; original verdicts are noted where they differ. C4 and C5 were not executed. C16 is a comparator replication of \citet  {Li2026}, not a survivor candidate.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:screen}{{2}{8}{Selection-rule verdicts on the balanced target ($n = 23$ graded checkpoints, 8 families, 11 lineages). $\rho $: Spearman with $S_2$. Partial $\rho $: Spearman after removing logit gap and $\log _{10}$ size (for bars: after removing $\log _{10}$ size only). Rules S2(b) and S3 use the amended forms; original verdicts are noted where they differ. C4 and C5 were not executed. C16 is a comparator replication of \citet {Li2026}, not a survivor candidate}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Scatter plot of C2 (self-ablation sensitivity) versus balanced safety ($S_2$) for the 23 graded checkpoints. Points are coloured by architecture family. C2 achieves Spearman $\rho = 0.90$ $[0.79, 0.97]$. The plot reveals a near-binary split: 10 of 23 models have $|C2| > 0.1$ (right cluster), while 13 cluster near zero. The dashed vertical line marks $|C2| = 0.1$.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:screen_scatter}{{3}{9}{Scatter plot of C2 (self-ablation sensitivity) versus balanced safety ($S_2$) for the 23 graded checkpoints. Points are coloured by architecture family. C2 achieves Spearman $\rho = 0.90$ $[0.79, 0.97]$. The plot reveals a near-binary split: 10 of 23 models have $|C2| > 0.1$ (right cluster), while 13 cluster near zero. The dashed vertical line marks $|C2| = 0.1$}{figure.3}{}}
